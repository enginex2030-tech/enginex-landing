# Cache policy by path. Files under /media/ carry a version in their name, so
# they can be cached for a year; an empty value sends no Cache-Control header.
map $uri $ex_cache_control {
  default "";
  /sw.js "no-cache";
  ~^/media/ "public, max-age=31536000, immutable";
}

# The proxy in front of this container terminates TLS and reports the original
# scheme. Anything that is not https://enginex2030.com is sent there in one 301.
map $host $ex_canonical_host {
  ~^www\.(?<bare>.+)$ $bare;
  default $host;
}

map "$http_x_forwarded_proto:$host" $ex_needs_redirect {
  default 0;
  ~^http: 1;
  ~^[^:]*:www\. 1;
}

server {
  listen 80 default_server;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  # Keep redirects relative (e.g. /en -> /en/) so they never downgrade to http://.
  absolute_redirect off;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Cache-Control $ex_cache_control always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ https://www.googletagmanager.com https://pagead2.googlesyndication.com https://cdn.tailwindcss.com https://code.iconify.design https://cdnjs.cloudflare.com; connect-src 'self' __VITE_API_BASE_URL__ https://www.google-analytics.com https://region1.google-analytics.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://api.iconify.design https://cdn.tailwindcss.com; style-src 'self' __CSP_STYLE_HASHES__ 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://hoirqrkdgbmvpwutwuwj.supabase.co; font-src 'self' https://fonts.gstatic.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  if ($ex_needs_redirect) {
    return 301 https://$ex_canonical_host$request_uri;
  }

  error_page 404 /404.html;

  location = /404.html {
    internal;
  }

  # Serve the redesigned landing page at the original PHP URLs as HTML.
  location ~ ^/(index|preview|concept)\.php$ {
    default_type text/html;
    try_files /index.html =404;
  }

  location / {
    try_files $uri $uri/ =404;
  }
}
